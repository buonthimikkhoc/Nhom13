{
  "name": "nhom13-ecommerce-core",
  "version": "1.0.0",
  "private": true,
  "description": "Website Bán Thiết Bị Công Nghệ - E-commerce Core (Phân Hệ Frontend & Backend)",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace=Backend run dev",
    "dev:frontend": "npm --workspace=Frontend run dev",
    "dev:api": "npm --workspace=Backend run dev",
    "dev:web": "npm --workspace=Frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --workspace=Backend run build",
    "build:frontend": "npm --workspace=Frontend run build",
    "build:api": "npm --workspace=Backend run build",
    "build:web": "npm --workspace=Frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

